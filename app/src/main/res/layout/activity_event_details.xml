<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:weightSum="100">

    <ImageView
        android:id="@+id/ivDetailsImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="50"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDetailsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvDetailsCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/purple_button" />

        <View android:layout_width="match_parent" android:layout_height="10dp" />

        <TextView
            android:id="@+id/tvDetailsLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_dark_gray" />

        <TextView
            android:id="@+id/tvDetailsDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_dark_gray" />

        <View android:layout_width="match_parent" android:layout_height="15dp" />

        <TextView
            android:id="@+id/tvDetailsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_dark_gray" />

        <View android:layout_width="match_parent" android:layout_height="15dp" />

        <TextView
            android:id="@+id/tvDetailsFreeSpots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#FFA500"
            android:visibility="gone" />

        <View android:layout_width="match_parent" android:layout_height="10dp" />

        <TextView
            android:id="@+id/tvDetailsRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_dark_gray" />

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:orientation="horizontal"
        android:weightSum="100">

        <Button
            android:id="@+id/btnInterested"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:text="@string/btn_interested_text"
            android:textColor="@color/white"
            android:backgroundTint="@color/purple_button" />


        <Button
            android:id="@+id/btnAttending"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:text="@string/btn_attending_text"
            android:textColor="@color/white"
            android:backgroundTint="@color/purple_button" /> </LinearLayout>

</LinearLayout>